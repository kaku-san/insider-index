{
  "name": "insiderindex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npx --no-install tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "holdings:ingest": "node --env-file=.env.local --experimental-strip-types scripts/ingest-holdings.mts",
    "indexes:publish": "node --env-file=.env.local --experimental-strip-types scripts/publish-holdings-indexes.mts",
    "profiles:publish": "node --env-file=.env.local --experimental-strip-types scripts/publish-top-profiles.mts",
    "catalog:snapshot": "node --experimental-strip-types scripts/snapshot-catalog.mts",
    "indexes:map:top20": "node --experimental-strip-types scripts/map-top20-index-vaults.mts",
    "fmp:holdings:bucket": "node --experimental-strip-types scripts/extract-fmp-holdings-bucket.mts",
    "raydium:snapshot": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/snapshot-raydium-pools.mts",
    "vault:redeem:preflight": "node --experimental-strip-types scripts/redeem-devnet-vault.mts",
    "keeper:devnet": "node --experimental-strip-types scripts/devnet-keeper-tick.mts",
    "keeper:kaku-san": "node --experimental-strip-types scripts/kaku-san-keeper-tick.mts",
    "keeper:index": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/insiderindex-keeper-tick.mts",
    "keeper:cycle": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/insiderindex-cycle-keeper.mts",
    "keeper:mag7-deposit": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/mag7-settle-deposit.mts",
    "keeper:mag7-watch": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/mag7-settle-deposit.mts --watch-vault --execute --watch",
    "vault:settle:devnet": "node --experimental-strip-types scripts/settle-devnet-vault.mts",
    "vault:cycle": "node --experimental-strip-types scripts/vault-full-cycle.mts",
    "nav-vault": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/nav-vault-cli.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@noble/curves": "1.8.0",
    "@noble/hashes": "1.8.0",
    "@privy-io/react-auth": "^3.42.0",
    "@raydium-io/raydium-sdk-v2": "0.2.70-alpha",
    "@solana-program/memo": "^0.13.1",
    "@solana-program/system": "^0.14.1",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.3.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@supabase/supabase-js": "^2.116.0",
    "@symmetry-hq/sdk": "1.0.22",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/bn.js": "5.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "litesvm": "1.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
