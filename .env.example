# Local: copy to .env.local, fill keys, `npm run dev`.
# Demo / production host: https://stocklana.barelystable.dev
# Server: gitignored .env at /srv/projects/stocklana (deploy never rsyncs .env).
# Never commit real secret values.

# Form4API — primary disclosure source (Form 4 + Congress).
# Live feed when set; mock Form 4 + House PTRs when empty.
FORM4API_KEY=

# Privy Solana wallet.
# Client: NEXT_PUBLIC_PRIVY_APP_ID (NEXT_PUBLIC_PRIVY_APPID is also accepted).
# Server SDK (when wired): PRIVY_APP_ID + PRIVY_APP_SECRET.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Helius RPC for @solana/kit (`src/lib/helius.ts`).
# When HELIUS_API_KEY is set, the RPC URL is:
#   https://mainnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>
# When unset, falls back to https://api.mainnet-beta.solana.com
# Used with Jupiter for live quotes (`POST /api/quote`).
HELIUS_API_KEY=

# Jupiter Swap V2 /order → /execute (`src/lib/jupiter.ts`).
# Live quotes/swaps when set; stub order when empty.
JUPITER_API_KEY=

# Supabase position persistence.
# Without these keys, positions stay in memory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
