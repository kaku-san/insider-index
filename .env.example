# Local: copy to .env.local, fill keys, `npm run dev`.
# Set to 1 only for labelled, read-only design fixtures. Default is live APIs.
NEXT_PUBLIC_INSIDERINDEX_PREVIEW=0
# Legacy alias still accepted:
NEXT_PUBLIC_STOCKLANA_PREVIEW=0
# Canonical product URL: https://insiderindex.xyz (InsiderIndex.xyz)
# Never commit real secret values.

# ── Data sources ────────────────────────────────────────────────────────────
# The public feed uses the committed research bundle. The following credentials
# configure separate ingest adapters; saved people/portfolio reads use Supabase.
# Insiders (Form 4): SEC EDGAR is primary and needs NO key. SEC requires this
# descriptive User-Agent with operator contact info; requests fail closed when empty.
SEC_EDGAR_USER_AGENT=
# Recent Form 4 filings scanned per issuer (default 20). Set EDGAR_DISABLED=1 to skip EDGAR.
EDGAR_FILINGS_PER_TICKER=

# FMP person directory + annual books + activity (server-only; no mock fallback).
FMP_API_KEY=

# Congress (House + Senate PTRs): AInvest Congressional Trades is primary.
# Free key: https://www.ainvest.com/business/developer-manage/
# Without it the congress lane is OFF in production (no invented politicians).
AINVEST_API_KEY=
# AInvest is ticker-scoped, so the lane crawls a ticker universe and groups by
# filer. wide = ~300 hand-kept names; catalog (default) adds US-looking xStock
# underlyings; full adds every Backpack .US token (~1,300, heavy on free tier).
AINVEST_UNIVERSE=
# Explicit override list ("NVDA,AAPL"); pages of AINVEST_PAGE_SIZE (100) per ticker (default 2).
AINVEST_TICKERS=
AINVEST_PAGES_PER_TICKER=
# EDGAR issuer set: default mega-caps (~30 s cold); wide = S&P core + frequent PTR names.
EDGAR_UNIVERSE=
EDGAR_TICKERS=

# ── Buy catalog (keyless, live; committed snapshot as fallback) ──────────────
# xstocks.com products + api.backpack.exchange assets. Set to 1 to drop an issuer.
XSTOCKS_CATALOG_DISABLED=
BACKPACK_CATALOG_DISABLED=

# Form4API — fallback only (insiders + House PTRs) when EDGAR/AInvest yield nothing.
FORM4API_KEY=

# Labelled mock fixtures when a live source is missing. Development defaults to
# on and accepts an explicit 1 or 0; production always disables fixtures.
STOCKLANA_ALLOW_MOCKS=

# ── Wallet / trade ───────────────────────────────────────────────────────────
# Privy Solana wallet.
# Client: NEXT_PUBLIC_PRIVY_APP_ID (NEXT_PUBLIC_PRIVY_APPID is also accepted).
# Server SDK (when wired): PRIVY_APP_ID + PRIVY_APP_SECRET.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Helius RPC (`src/lib/helius.ts`). When set, server-side RPC and the browser
# proxy at /api/rpc use https://mainnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>.
# When unset, falls back to https://api.mainnet-beta.solana.com.
HELIUS_API_KEY=
# Optional websocket for wallet subscriptions (defaults to the public mainnet ws).
NEXT_PUBLIC_SOLANA_WS_URL=

# NAV vault: mainnet by default. Empty allowlists serve every index with a NAV PDA.
# Keep server/client switches aligned. Never put a signing key in the web app.
STOCKLANA_NAV_VAULT_DISABLED=
NEXT_PUBLIC_NAV_VAULT_DISABLED=
STOCKLANA_NAV_VAULT_NETWORK=
STOCKLANA_NAV_VAULT_PROGRAM_ID=
STOCKLANA_NAV_VAULT_RPC_URL=
STOCKLANA_NAV_VAULT_INDEXES=
NEXT_PUBLIC_NAV_VAULT_INDEXES=

# Jupiter: the NAV keeper uses v1 CPI-safe swap routes and v2 mark quotes.
# Individual copy trades use Swap V2 `/order` → `/execute`.
# This credential is server/operator-only; never expose it or HELIUS_API_KEY via NEXT_PUBLIC_.
# JUPITER_MODE=live|stub forces the development copy-trade path. Production is always
# live; development defaults live with a key and stub without one.
JUPITER_API_KEY=
JUPITER_MODE=

# Supabase saved books, copy-order contexts, and copy receipts. Production copy
# trading requires the URL and service role plus migrations
# 202609150001_copy_positions.sql and 202609150002_prune_copy_orders.sql;
# development alone may use the in-memory receipt fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
