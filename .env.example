# Form4API — primary disclosure source. Without this key the feed uses mock Form 4 data.
FORM4API_KEY=

# Privy Solana. The app ships a provider stub; wire the real SDK when these are set.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Helius RPC for @solana/kit
HELIUS_API_KEY=

# Jupiter Swap V2 /order → /execute
JUPITER_API_KEY=

# Supabase position persistence. Without these keys, positions stay in memory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
